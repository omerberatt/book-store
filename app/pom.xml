<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bookstore</groupId>
        <artifactId>bookstore-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>app</artifactId>
    <name>Book Store :: App</name>
    <description>Entry point that puts the business modules together. Becomes a WAR on Payara Micro in phase 6 (ADR-0010).</description>

    <dependencies>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>shared-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>shared-web</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>catalog</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>customer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>sales</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>review</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>shared-jdbc</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>shared-kernel</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>catalog</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>customer</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.bookstore</groupId>
            <artifactId>sales</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- ./mvnw -pl app exec:java starts the API (see the README). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-plugin.version}</version>
                <configuration>
                    <mainClass>com.bookstore.app.BookstoreServer</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
